# 이 파일을 .env로 복사한 뒤 값을 채우세요:  cp .env.example .env

# Gemini API — 학습 내용 분석 · 퀴즈 · 메타인지 평가 (src/services/geminiService.ts)
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Gemini API — 챗봇 (services/geminiService.ts, vite.config.ts에서 주입)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API — 음성 대화 모달 (GPT-4o · TTS)
VITE_GPT_API_KEY=your_openai_api_key_here

# Supabase — 로그인 · 노드/링크 저장
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
