# ============================================================
#  자리픽 서버 환경변수
#  이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.
#    Windows:  copy .env.example .env
#    macOS/Linux: cp .env.example .env
#  .env 는 git에 커밋되지 않습니다(.gitignore 등록됨).
# ============================================================

# ============================================================
#  AI (선택) — 하나만 넣어도 동작합니다
#
#  키가 하나도 없으면 규칙 기반으로 자동 전환되며 서비스는 그대로 동작합니다.
#  키를 넣으면 분석 근거·심층 리포트·AI 상담 챗봇이 LLM으로 전환됩니다.
#  숫자는 어느 경우에도 서버가 계산합니다. LLM은 해석만 담당합니다.
# ============================================================

# --- Gemini (Google AI Studio) -------------------------------
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- OpenAI --------------------------------------------------
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (선택) ----------------------------------------
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- 프로바이더 선택 -------------------------------------------
# auto = 아래 ORDER 순서대로 '키가 등록된' 첫 프로바이더를 사용
# 특정 값(gemini / openai / anthropic)을 넣으면 그것만 사용합니다.
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,openai,anthropic

# 호출이 실패하면 다음 프로바이더로 자동 전환할지 (true/false)
AI_FAILOVER=true

# AI 호출 1건당 최대 출력 토큰
AI_MAX_TOKENS=1200

# AI 응답 대기 제한 (ms). 초과하면 다음 프로바이더 → 규칙 기반 순으로 폴백합니다.
AI_TIMEOUT_MS=20000

# 에이전트가 도구를 연쇄 호출할 수 있는 최대 횟수 (무한루프 방지)
AI_MAX_TOOL_TURNS=5

# ============================================================
#  SGIS (통계청 통계지리정보서비스) — 전국 통계
#
#  전국 행정동 단위 인구·가구·주택·사업체 통계를 제공합니다.
#  서울 외 지역 조회에 사용하며, 키가 없으면 해당 기능만 비활성화되고
#  기존 서울 분석은 그대로 동작합니다.
#
#  발급: https://sgis.kostat.go.kr/developer  (무료 · 일 50,000회)
# ============================================================
SGIS_SERVICE_ID=
SGIS_SECURITY_KEY=
SGIS_BASE_URL=https://sgisapi.kostat.go.kr/OpenAPI3

# SGIS 호출 대기 제한 (ms)
SGIS_TIMEOUT_MS=10000

# 조회 결과 캐시 유지 시간 (분). 일일 호출 한도를 아끼기 위해 캐시합니다.
SGIS_CACHE_MIN=720

# ============================================================
#  LOCALDATA (행정안전부 지방행정 인허가) — 전국 개·폐업
#
#  전국 인허가 업소의 영업상태·인허가일·폐업일을 제공합니다.
#  SGIS에 없는 '폐업률'을 전국에서 산출하는 유일한 무료 경로입니다.
#
#  발급: https://www.data.go.kr 에서 아래 10개 서비스를 각각 활용신청
#        (개발계정 10,000회/일 · 자동승인 / 운영계정은 활용사례 등록 시 증량)
#  키는 10개 서비스가 공용입니다.
# ============================================================
LOCALDATA_API_KEY=
LOCALDATA_BASE_URL=https://apis.data.go.kr/1741000

# 호출 대기 제한 (ms)
# 미용업(beauty_salons)은 조건과 무관하게 항상 30초 안팎이 걸린다. 45초는 그 여유다.
LOCALDATA_TIMEOUT_MS=45000

# 수집 시 동시 호출 수 (과도하게 올리면 차단될 수 있습니다)
LOCALDATA_CONCURRENCY=5

# 서비스당 1회 수집에서 넘지 않을 호출 수 (개발계정 일일 한도 = 10,000)
LOCALDATA_DAILY_LIMIT=9500

# --- 서버 ---------------------------------------------------
PORT=8787

# SQLite 경로 (server 폴더 기준 상대경로 또는 절대경로)
DB_PATH=../seoul_db.db

# 사전 집계 캐시 경로
CACHE_PATH=./cache/areas.json

# 정적 파일 루트 (프런트엔드). 비우면 정적 서빙을 하지 않습니다.
STATIC_DIR=..

# --- 분석 파라미터 -------------------------------------------
# 분석 대상 상권 유형 (쉼표 구분): 골목상권,발달상권,전통시장,관광특구
AREA_TYPES=발달상권,골목상권,관광특구

# 후보 상권 최소 일평균 유동인구 (너무 작은 상권 제외)
MIN_DAILY_FOOT=3000

# ── 소상공인365 (소상공인시장진흥공단 빅데이터 플랫폼) ──────────────
# 지도 데이터(/gis/api/*)는 인증이 필요 없어 키 없이도 동작한다.
# 아래는 분석 '화면' 접근키로, 리포트에서 해당 화면으로 딥링크할 때만 쓴다.
# 발급: https://bigdata.sbiz.or.kr/#/apiMain/dataApi/openapi
SBIZ_CERT_HP_REPORT=
SBIZ_CERT_WEATHER=
SBIZ_CERT_SLS_IDEX=
SBIZ_CERT_STOR_STTUS=
SBIZ_CERT_STCAR_STTUS=
SBIZ_CERT_DETAIL=
SBIZ_CERT_STARTUP_PUBLIC=
SBIZ_CERT_DELIVERY=
SBIZ_CERT_TOUR=
SBIZ_CERT_SIMPLE=
SBIZ_CERT_SNS_ANALY=
# SBIZ_ENABLED=false        # 소상공인365 연동 전체를 끌 때만

# ── 한국부동산원 R-ONE (상업용부동산 임대동향조사) ──────────────────
# 임대료·공실률·권리금. 발급: https://www.reb.or.kr/r-one/portal/openapi/selectServicePage.do
RONE_API_KEY=
